# Provider configuration
# PROVIDER defaults to 'openrouter' for backwards compatibility.
# Valid: openrouter | openai | together | deepinfra | fireworks | groq
#        | chutes | cerebras | azure
PROVIDER=openrouter

# API key (required). Legacy: OPENROUTER_API_KEY
API_KEY=your_api_key_here

# Model id (optional; per-provider default if unset). Legacy: OPENROUTER_MODEL
# Required for providers without a default: together, deepinfra, fireworks, chutes
# Ignored by azure (the deployment is in BASE_URL, not the model field)
MODEL=google/gemini-2.0-flash-exp:free

# Base URL (optional; per-provider default if unset). MUST be a full prefix
# including /v1 or /api/v1 as appropriate for the provider.
# Legacy: OPENROUTER_BASE_URL
# BASE_URL=https://openrouter.ai/api/v1
#
# For azure: BASE_URL is REQUIRED and must be the full deployment URL
# including the api-version query parameter, e.g.:
#   https://<resource>.openai.azure.com/openai/deployments/<deployment>?api-version=2024-02-15-preview
# Azure has no per-provider default for BASE_URL — the user must always
# supply it. MODEL is ignored for azure (the deployment name is in the URL).

# Optional extra headers as a JSON object string.
# For OpenRouter ranking: '{"HTTP-Referer":"https://your.app","X-Title":"Your App"}'
# EXTRA_HEADERS=

# Server Configuration
PORT=3000
LOG_LEVEL=info
RETRY_ATTEMPTS=3
MAX_IMAGE_SIZE=10485760

# --- Legacy fallback (deprecated, still supported) ---
# These are read only if the corresponding new var above is unset.
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=...
# OPENROUTER_BASE_URL=...